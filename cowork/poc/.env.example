# คัดลอกเป็น .env แล้วเติมค่าจริง — ไฟล์นี้คือ "ฝั่ง orchestrator" ที่เก็บ secret ทั้งหมด
# (container ของ agent ไม่เห็นค่าพวกนี้เลย)

# --- Managed Agents ---
ANTHROPIC_API_KEY=sk-ant-xxx
TRIAGE_AGENT_ID=agent_xxx          # id ของ prinnie-triage (coordinator) หลัง create
SUPPORT_ENV_ID=env_xxx             # id ของ prinnie-support-env

# --- LINE ---
LINE_CHANNEL_ACCESS_TOKEN=xxx
LINE_CHANNEL_SECRET=xxx

# --- prinnie-line backend (DB / Stripe อยู่ฝั่งนี้แล้ว, แค่ชี้ให้ adapter ใช้) ---
DATABASE_URL=postgres://...
STRIPE_SECRET_KEY=sk_live_xxx

# --- เฟส ---
RELEASE_PHASE=1                    # 1 = copilot (staff กดส่งทุกเคส) | 2 = auto เฉพาะ FAQ+account
ORCHESTRATOR_PORT=8080
