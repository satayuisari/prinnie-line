# Standalone — ไม่พึ่ง Prinnie333 web เลย
DATABASE_URL=postgresql://user:password@localhost:5432/prinnie_line

# LINE Developer Console -> Your Channel
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret
LINE_LIFF_ID=your_liff_id

# ════════ SAFETY (สำคัญตอนเทสบน OA จริง 10k followers) ════════
# TEST_MODE=true → push ได้เฉพาะ userId ใน TEST_USER_IDS, broadcast ถูกบล็อก
TEST_MODE=true
TEST_USER_IDS=Uxxxxxxxxxxxxx,Uyyyyyyyyyyyyy

# โฟลเดอร์ JSON content (default ./data)
DATA_DIR=./data

# ════════ Beam Checkout (ชำระเงิน — แทน Stripe) ════════
# ถ้าไม่ตั้ง BEAM_MERCHANT_ID + BEAM_API_KEY → endpoint ชำระเงินคืน 410 "กำลังปรับปรุง"
# auth = HTTP Basic (merchantId:apiKey). หาได้ใน Beam dashboard
BEAM_MERCHANT_ID=your_beam_merchant_id
BEAM_API_KEY=your_beam_api_key
BEAM_ENV=sandbox                 # sandbox (playground) | production
BEAM_WEBHOOK_SECRET=             # HMAC key สำหรับตรวจ X-Beam-Signature (ตั้ง webhook ใน dashboard → /api/payment/beam-webhook)
# PUBLIC_BASE_URL=https://prinnie-app-production.up.railway.app   # ใช้ทำ redirectUrl หลังจ่าย
# SUB_PRICE_THB=399              # ราคาสมาชิก/เดือน (default 399)
# COUPLE_PRICE_THB=149           # ราคาปลดล็อกดวงคู่ครั้งเดียว (default 149)

# ════════ สิทธิ์ดูดวงกับ อ.ปรินนี่ (สมาชิกจ่ายครบตามเกณฑ์) ════════
# ⚖️ เป็น "สิทธิ์ตามเงื่อนไข" ไม่ใช่การสุ่ม → ไม่ต้องขอใบอนุญาตชิงโชค
#    ถ้าจะเปลี่ยนเป็นสุ่มจริง ต้องขออนุญาตกรมการปกครองก่อนจัด (พ.ร.บ.การพนัน ม.8)
LOYALTY_ENABLED=false            # true = เปิดให้สิทธิ์ + แจ้งลูกค้าอัตโนมัติสิ้นเดือน
# LOYALTY_MILESTONE=3            # จ่ายค่าสมาชิกครบกี่ครั้งถึงได้สิทธิ์ (default 3)
# LOYALTY_VALUE=3000             # มูลค่าที่ประกาศ (บาท)
# LOYALTY_EXPIRE_DAYS=90         # ต้องใช้สิทธิ์ภายในกี่วัน

# ════════ Affiliate อินฟลู (ค่าคอมแบบ First Paid Customer) ════════
# ไม่ตั้งก็ได้ — โค้ดใช้ค่า default ตามนี้อยู่แล้ว
# AFFILIATE_CPA=50               # ค่าคอมฐาน/ลูกค้าใหม่ที่จ่ายจริงครั้งแรก (renew ไม่ได้เพิ่ม)
# AFFILIATE_HOLD_DAYS=7          # กันช่วง refund/fraud ก่อน approve จ่ายได้
# AFFILIATE_BUDGET=10000         # งบค่าคอมรวม (แสดงบนแดชบอร์ด)
# โบนัส milestone (20 คน→+500฿, 50 คน→+1500฿) จ่ายมือแยก — ไม่อยู่ในตาราง ledger

# Server
PORT=3000
NODE_ENV=production
