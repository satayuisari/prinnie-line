# Standalone — ไม่พึ่ง Prinnie333 web เลย
DATABASE_URL=postgresql://user:password@localhost:5432/prinnie_line

# LINE Developer Console -> Your Channel
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret
LINE_LIFF_ID=your_liff_id

# ════════ SAFETY (สำคัญตอนเทสบน OA จริง 10k followers) ════════
# TEST_MODE=true → push ได้เฉพาะ userId ใน TEST_USER_IDS, broadcast ถูกบล็อก
TEST_MODE=true
TEST_USER_IDS=Uxxxxxxxxxxxxx,Uyyyyyyyyyyyyy

# โฟลเดอร์ JSON content (default ./data)
DATA_DIR=./data

# ════════ PromptPay (ช่องทางชำระเงินเดียว) ════════
# ลูกค้าสแกน QR → โอน → ส่งสลิปเข้าแชท → staff อนุมัติบน dashboard → ระบบ activate
# ตั้งอย่างใดอย่างหนึ่ง (ไม่ตั้งเลย → endpoint ชำระเงินคืน 410 "กำลังปรับปรุง"):
#   1) PROMPTPAY_QR_PAYLOAD = สตริง QR ร้านค้าแบบ static (ระบบแทรกยอดเงินให้เอง)
#   2) PROMPTPAY_ID = เบอร์มือถือ / เลขบัตรประชาชน → สร้าง QR ส่วนบุคคล
PROMPTPAY_ID=0812345678
# PROMPTPAY_QR_PAYLOAD=
# ชื่อบัญชีที่โชว์ในช่อง "โอนเอง" บนหน้าจ่ายเงิน (ให้ลูกค้ามั่นใจว่าโอนถูกคน) — ไม่ตั้งก็ได้
PROMPTPAY_NAME=

# ════════ ราคา / ลิงก์สาธารณะ ════════
# PUBLIC_BASE_URL=https://prinnie-app-production.up.railway.app   # ใช้ทำลิงก์หน้าจ่ายเงิน
# SUB_PRICE_THB=399              # ราคาสมาชิก/เดือน (default 399)
# COUPLE_PRICE_THB=199           # ราคาปลดล็อกดวงคู่ครั้งเดียว (default 199)

# ════════ Ask Prinnie 3 — สิทธิ์สมาชิก (ถามอาจารย์ได้ 3 คำถาม) ════════
# ⚖️ ให้ตามเงื่อนไข ไม่มีการสุ่ม → ลดความเสี่ยงเข้าข่ายกิจกรรมเสี่ยงโชคอย่างมีนัยสำคัญ
#    แต่ต้องให้ที่ปรึกษากฎหมายยืนยัน Terms ก่อนเปิดใช้จริง
#    การจัด classification ทางภาษีของสิทธิ์นี้ ให้บัญชีพิจารณาใหม่ (ไม่ใช่กติกาของรางวัลชิงโชค)
LOYALTY_ENABLED=false            # ⚠️ เปิดเมื่อกำหนด slot capacity ของอาจารย์เรียบร้อยแล้วเท่านั้น
# LOYALTY_MILESTONE=3            # ชำระค่าสมาชิกครบกี่รอบถึงได้สิทธิ์ (default 3)
# LOYALTY_EXPIRE_DAYS=60         # ต้องใช้สิทธิ์ภายในกี่วัน (default 60)
# ASK_BRIEF_MODEL=claude-sonnet-5  # โมเดลที่ใช้สรุป brief ให้อาจารย์ (ไม่ได้ตอบแทนอาจารย์)

# ════════ Affiliate อินฟลู (ค่าคอมแบบ First Paid Customer) ════════
# ไม่ตั้งก็ได้ — โค้ดใช้ค่า default ตามนี้อยู่แล้ว
# AFFILIATE_CPA=50               # ค่าคอมฐาน/ลูกค้าใหม่ที่จ่ายจริงครั้งแรก (renew ไม่ได้เพิ่ม)
# AFFILIATE_HOLD_DAYS=7          # กันช่วง refund/fraud ก่อน approve จ่ายได้
# AFFILIATE_BUDGET=10000         # งบค่าคอมรวม (แสดงบนแดชบอร์ด)
# โบนัส milestone (20 คน→+500฿, 50 คน→+1500฿) จ่ายมือแยก — ไม่อยู่ในตาราง ledger

# Server
PORT=3000
NODE_ENV=production
